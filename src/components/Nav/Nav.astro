---
import Container from "../ui/Container.astro";
import ThemeToggle from "../ui/ThemeToggle";

type Link = { href: string; label: string };

const links: Link[] = [
  { href: "#work", label: "Work" },
  { href: "#journey", label: "Journey" },
  { href: "#toolkit", label: "Toolkit" },
  { href: "#contact", label: "Contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-header>
  <Container class="py-6 transition-all duration-300" data-header-container>
    <nav class="pointer-events-auto flex items-center justify-between">
      <!-- Logo -->
      <a href="#" class="group">
        <span class="font-display text-xl font-bold tracking-tighter text-[--color-text] group-hover:text-[--color-accent] transition-colors" data-nav-logo>
          RAHUL K
        </span>
      </a>

      <!-- Navigation -->
      <div class="hidden items-center gap-10 lg:gap-12 md:flex">
        {links.map((l) => (
          <a
            href={l.href}
            class="text-xs font-medium text-[--color-text-secondary] transition hover:text-[--color-text]"
            data-nav-link
          >
            {l.label}
          </a>
        ))}
      </div>

      <!-- Action & Toggle -->
      <div class="flex items-center gap-4 sm:gap-6">
        <ThemeToggle client:load />
        <a href="#contact" class="hidden sm:inline-flex rounded-full bg-[--color-text] px-6 py-2.5 text-xs font-bold tracking-widest text-[--color-background] transition hover:bg-[--color-accent]" data-nav-button>
          LET'S TALK
        </a>
      </div>
    </nav>
  </Container>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const container = document.querySelector('[data-header-container]');

  const handleScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('bg-[--color-background]/80', 'backdrop-blur-xl', 'border-b', 'border-[--color-border]');
      container?.classList.remove('py-6');
      container?.classList.add('py-4');
    } else {
      header?.classList.remove('bg-[--color-background]/80', 'backdrop-blur-xl', 'border-b', 'border-[--color-border]');
      container?.classList.remove('py-4');
      container?.classList.add('py-6');
    }
  };

  window.addEventListener('scroll', handleScroll);
  handleScroll();
</script>
