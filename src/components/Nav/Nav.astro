---
import Container from "../ui/Container.astro";

type Link = { href: string; label: string };

const links: Link[] = [
  { href: "#work", label: "WORK" },
  { href: "#journey", label: "JOURNEY" },
  { href: "#toolkit", label: "TOOLKIT" },
  { href: "#contact", label: "CONTACT" },
];
---

<header class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-header>
  <Container class="py-6 transition-all duration-300" data-header-container>
    <nav class="pointer-events-auto flex items-center justify-between">
      <!-- Logo -->
      <a href="#" class="group">
        <span class="font-display text-xl font-bold tracking-tighter text-[#141413] group-hover:text-[#cc785c] transition-colors" data-nav-logo>
          RAHUL K
        </span>
      </a>

      <!-- Navigation -->
      <div class="hidden items-center gap-12 md:flex">
        {links.map((l) => (
          <a
            href={l.href}
            class="text-[10px] font-bold tracking-[0.25em] text-[#6c6a64] transition hover:text-[#141413]"
            data-nav-link
          >
            {l.label}
          </a>
        ))}
      </div>

      <!-- Action -->
      <div class="flex items-center gap-6">
        <a href="#contact" class="rounded-full border border-[#141413]/20 bg-[#141413] px-6 py-2.5 text-[10px] font-bold tracking-widest text-[#faf9f5] transition hover:bg-[#cc785c] hover:border-[#cc785c]" data-nav-button>
          LET'S TALK
        </a>
      </div>
    </nav>
  </Container>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const container = document.querySelector('[data-header-container]');

  const handleScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('bg-[#faf9f5]/80', 'backdrop-blur-xl', 'border-b', 'border-[#e6dfd8]');
      container?.classList.remove('py-6');
      container?.classList.add('py-4');
    } else {
      header?.classList.remove('bg-[#faf9f5]/80', 'backdrop-blur-xl', 'border-b', 'border-[#e6dfd8]');
      container?.classList.remove('py-4');
      container?.classList.add('py-6');
    }
  };

  window.addEventListener('scroll', handleScroll);
  handleScroll();
</script>
