---
import Container from "../ui/Container.astro";
import ThemeToggle from "../ui/ThemeToggle";

type Link = { href: string; label: string };

const links: Link[] = [
  { href: "#work", label: "Work" },
  { href: "#journey", label: "Journey" },
  { href: "#toolkit", label: "Toolkit" },
  { href: "#contact", label: "Contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-header>
  <Container class="py-8 transition-all duration-300" data-header-container>
    <nav class="pointer-events-auto flex items-center justify-between">
      <!-- Editorial Logo -->
      <a href="/" class="group flex items-center gap-4">
        <div class="w-10 h-10 bg-[--color-accent] rounded-lg flex items-center justify-center text-white font-display text-2xl font-black italic">
          R
        </div>
        <div class="flex flex-col leading-none">
          <span class="font-display text-lg font-bold tracking-tight text-[--color-text]">RAHUL</span>
          <span class="text-[9px] font-mono font-bold tracking-[0.2em] text-[--color-text-secondary] uppercase opacity-80">Product Designer</span>
        </div>
      </a>

      <!-- Minimalist Navigation -->
      <div class="hidden items-center gap-10 lg:gap-14 md:flex">
        {links.map((l) => (
          <a
            href={l.href}
            class="text-[11px] font-mono font-bold tracking-[0.2em] uppercase text-[--color-text-secondary] transition hover:text-[--color-accent] relative group"
            data-nav-link
          >
            {l.label}
            <span class="absolute -bottom-1.5 left-0 w-0 h-px bg-[--color-accent] transition-all duration-300 group-hover:w-full"></span>
          </a>
        ))}
      </div>

      <!-- Action & Toggle -->
      <div class="flex items-center gap-6">
        <ThemeToggle client:load />
      </div>
    </nav>
  </Container>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const container = document.querySelector('[data-header-container]');

  const handleScroll = () => {
    if (window.scrollY > 50) {
      header?.classList.add('bg-[--color-background]/80', 'backdrop-blur-xl', 'border-b', 'border-[--color-border]/50 shadow-sm');
      container?.classList.remove('py-8');
      container?.classList.add('py-4');
    } else {
      header?.classList.remove('bg-[--color-background]/80', 'backdrop-blur-xl', 'border-b', 'border-[--color-border]/50 shadow-sm');
      container?.classList.remove('py-4');
      container?.classList.add('py-8');
    }
  };

  window.addEventListener('scroll', handleScroll);
  handleScroll();
</script>
