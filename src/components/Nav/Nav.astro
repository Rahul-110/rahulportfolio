---
import Container from "../ui/Container.astro";

type Link = { href: string; label: string };

const links: Link[] = [
  { href: "#story", label: "ABOUT" },
  { href: "#work", label: "PROJECTS" },
  { href: "#contact", label: "CONTACT" },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <Container class="py-8">
    <nav class="pointer-events-auto flex items-center justify-between">
      <!-- Logo -->
      <a href="#" class="group">
        <span class="font-display text-xl font-bold tracking-tighter text-white">
          ANNA G
        </span>
      </a>

      <!-- Navigation -->
      <div class="hidden items-center gap-12 md:flex">
        {links.map((l) => (
          <a
            href={l.href}
            class="text-[10px] font-bold tracking-[0.25em] text-[--muted2] transition hover:text-white"
          >
            {l.label}
          </a>
        ))}
      </div>

      <!-- Action & Language -->
      <div class="flex items-center gap-10">
        <span class="hidden text-[10px] font-bold tracking-widest text-[--muted2] lg:inline">ENG / PYC</span>
        <a href="#contact" class="rounded-full border border-white/20 px-6 py-2.5 text-[10px] font-bold tracking-widest text-white transition hover:bg-white hover:text-black">
          LET'S TALK
        </a>
      </div>
    </nav>
  </Container>
</header>
