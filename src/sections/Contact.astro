---
import Container from "../components/ui/Container.astro";
import ContactStudio from "../components/motion/ContactStudio";
---

<section id="contact" class="relative py-28 md:py-40 bg-[--color-background] text-[--color-text] overflow-hidden border-t border-[--color-border]">
  <Container class="relative z-10 space-y-24">
    {/* Chapter Label */}
    <div>
      <div class="inline-flex items-center gap-2.5 bg-[--color-surface] border border-[--color-border] px-4 py-1.5 rounded-full backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-[--color-accent] animate-pulse"></span>
        <span class="text-[10px] sm:text-[11px] font-mono font-bold tracking-[0.25em] text-[--color-text] uppercase">
          06 / LET'S CONNECT
        </span>
      </div>
    </div>

    {/* Interactive Creative Contact Studio Component */}
    <ContactStudio client:load />

    {/* Minimal Premium Footer */}
    <footer class="pt-12 border-t border-[--color-border] space-y-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <span class="font-display font-bold text-[--color-text] text-lg tracking-tight">Rahul.</span>
          <span class="text-[--color-text-secondary]/30">•</span>
          <span class="text-xs font-mono text-[--color-text-secondary] uppercase tracking-widest">UI/UX Designer / Product Designer</span>
        </div>

        {/* Navigation Links */}
        <nav class="flex flex-wrap items-center justify-center gap-5 sm:gap-8 text-xs font-mono uppercase tracking-widest text-[--color-text-secondary]" aria-label="Footer navigation">
          <a href="#work" class="hover:text-[--color-text] transition-colors focus-visible:outline-none focus-visible:underline">Work</a>
          <a href="#journey" class="hover:text-[--color-text] transition-colors focus-visible:outline-none focus-visible:underline">Journey</a>
          <a href="#toolkit" class="hover:text-[--color-text] transition-colors focus-visible:outline-none focus-visible:underline">Toolkit</a>
          <a href="#process" class="hover:text-[--color-text] transition-colors focus-visible:outline-none focus-visible:underline">Design Process</a>
          <a href="#contact" class="hover:text-[--color-text] transition-colors focus-visible:outline-none focus-visible:underline">Contact</a>
        </nav>
      </div>
    </footer>
  </Container>
</section>
