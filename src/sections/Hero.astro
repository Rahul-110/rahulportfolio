---
import Container from "../components/ui/Container.astro";
import HeroReveal from "../components/motion/HeroReveal";
import AboutCharacterVideo from "../components/motion/AboutCharacterVideo";
---

<section id="hero" class="relative min-h-[90dvh] flex flex-col justify-center overflow-hidden pb-16 pt-28 bg-[#faf9f5] border-b border-[#e6dfd8]" data-hero-root>
  {/* Atmospheric Background Detail - subtle editorial feel */}
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute top-[-10%] right-[-10%] w-[600px] h-[600px] bg-[#cc785c]/5 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[400px] h-[400px] bg-[#5db8a6]/5 blur-[100px] rounded-full"></div>

    {/* Refined Grid */}
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: linear-gradient(#141413 1px, transparent 1px), linear-gradient(90deg, #141413 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>

  <Container class="relative z-10 pointer-events-none">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Left Column: Editorial Copy -->
      <div class="lg:col-span-7 space-y-12 pointer-events-auto">

        <div class="space-y-4" data-hero-item>
          <span class="text-[10px] font-mono font-bold tracking-[0.4em] text-[#cc785c] uppercase bg-[#cc785c]/10 border border-[#cc785c]/20 px-4 py-1.5 rounded-full inline-block">
            CHAPTER 01 / MEET THE DESIGNER
          </span>
        </div>

        <h1 class="font-display text-5xl sm:text-7xl lg:text-[96px] font-medium tracking-tight text-[#141413] leading-[0.95]" data-hero-item>
          I make complex <br />
          <span class="italic text-[#8e8b82]">things feel</span> <br />
          beautifully simple.
        </h1>

        <p class="text-xl text-[#6c6a64] font-normal leading-relaxed max-w-xl" data-hero-item>
          I'm a UI/UX Designer focused on SaaS, AI, and digital products — turning user needs and complex workflows into intuitive, thoughtful experiences.
        </p>

        <div class="pt-4 flex flex-wrap items-center gap-6" data-hero-item>
          <a href="#work" class="group flex items-center gap-4 bg-[#141413] text-[#faf9f5] px-8 py-4 rounded-none text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:bg-[#cc785c] hover:-translate-y-0.5">
            <span>Explore Work</span>
            <span class="group-hover:translate-x-1 transition-transform">↗</span>
          </a>
          <a href="/resume-page-1.png" target="_blank" rel="noopener noreferrer" class="text-xs font-bold tracking-[0.2em] uppercase text-[#141413] hover:text-[#cc785c] transition-colors">
            Download Résumé ↓
          </a>
        </div>
      </div>

      <!-- Right Column: Integrated 3D Identity -->
      <div class="lg:col-span-5 relative pointer-events-auto" data-hero-visual>
        <div class="relative w-full aspect-square flex items-center justify-center">
          <div class="w-full h-full scale-[1.2] translate-y-4">
            <AboutCharacterVideo client:load />
          </div>
        </div>
      </div>

    </div>
  </Container>

  {/* Scroll Indicator */}
  <div class="absolute bottom-10 left-10 flex items-center gap-4 text-[9px] font-mono text-[#8e8b82] uppercase tracking-[0.3em]">
    <div class="w-12 h-px bg-[#141413]/20"></div>
    <span>Scroll</span>
  </div>

  <HeroReveal client:load />
</section>

<style>
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
</style>
