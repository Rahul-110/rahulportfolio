---
import Container from "../components/ui/Container.astro";
import AboutCharacterVideo from "../components/motion/AboutCharacterVideo";
---

<section id="hero" class="relative min-h-[92dvh] flex flex-col justify-center pt-36 pb-24 bg-[--color-background] overflow-hidden" data-hero-root>
  <!-- Decorative background elements -->
  <div class="absolute top-0 right-0 w-[40%] h-full bg-[--color-surface]/30 -skew-x-12 transform translate-x-1/4 pointer-events-none -z-0 border-l border-[--color-border]/20"></div>

  <Container class="relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      {/* LEFT COLUMN: Editorial Content */}
      <div class="lg:col-span-6 space-y-12" data-hero-item>
        <div class="flex items-center gap-4">
          <span class="w-10 h-px bg-[--color-accent]"></span>
          <span class="text-[11px] font-mono font-bold tracking-[0.25em] uppercase text-[--color-text]">
            1+ YEAR PROFESSIONAL EXPERIENCE
          </span>
        </div>

        <h1 class="font-display text-6xl sm:text-7xl lg:text-[8.5rem] font-medium tracking-tight text-[--color-text] leading-[0.9]">
          I make complex <br />
          things feel <br />
          <span class="italic font-serif text-[--color-accent]">beautifully simple.</span>
        </h1>

        <p class="text-lg sm:text-2xl font-normal leading-relaxed text-[--color-text-secondary] max-w-lg">
          UI/UX Designer creating thoughtful SaaS and AI product experiences.
        </p>

        <div class="flex flex-wrap items-center gap-6 pt-2">
          <a
            href="#work"
            class="group inline-flex items-center gap-3 bg-[--color-accent] text-white px-10 py-4 rounded-full text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:bg-[--color-text] hover:shadow-2xl hover:-translate-y-1"
          >
            <span>Explore My Work</span>
            <span class="group-hover:translate-x-1.5 transition-transform duration-300">→</span>
          </a>
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 bg-transparent border border-[--color-border] px-9 py-4 rounded-full text-[--color-text] text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:border-[--color-text] hover:bg-[--color-surface] hover:-translate-y-1"
          >
            <span>Download Résumé</span>
            <span class="text-base group-hover:translate-y-0.5 transition-transform duration-300">↓</span>
          </a>
        </div>
      </div>

      {/* RIGHT COLUMN: Visual Identity Integration */}
      <div class="lg:col-span-6 relative flex items-center justify-center pt-12 lg:pt-0" data-hero-visual>
        {/* The Terracotta Arch backdrop from reference */}
        <div class="absolute right-0 bottom-[-5%] w-[100%] h-[110%] bg-[--color-accent]/15 rounded-t-full border border-[--color-accent]/20 -z-0 pointer-events-none shadow-inner"></div>

        {/* Character Visual Frame */}
        <div class="relative w-full z-10 max-w-xl group">
          <AboutCharacterVideo client:load />
        </div>
      </div>
    </div>

    {/* Refined Scroll Indicator */}
    <div class="pt-32 flex items-center gap-4 text-[10px] font-mono font-bold tracking-[0.3em] text-[--color-text-secondary] uppercase opacity-70">
      <div class="w-5 h-9 rounded-full border border-[--color-border] flex items-start justify-center p-1.5">
        <div class="w-1.5 h-1.5 bg-[--color-accent] rounded-full animate-bounce"></div>
      </div>
      <span>Scroll to explore</span>
    </div>
  </Container>
</section>
