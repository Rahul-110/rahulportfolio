---
import Container from "../components/ui/Container.astro";
import MouseParallax from "../components/motion/MouseParallax";
---

<section class="relative overflow-hidden pb-12 pt-14 sm:pb-16 sm:pt-20">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 opacity-70 [mask-image:radial-gradient(60%_60%_at_50%_20%,black,transparent)]">
      <div
        class="absolute -top-40 left-1/2 h-[720px] w-[720px] -translate-x-1/2 rounded-full blur-3xl"
        style="background: radial-gradient(circle at 30% 30%, rgba(167,139,250,.25), transparent 60%), radial-gradient(circle at 70% 60%, rgba(96,165,250,.18), transparent 55%);"
        data-parallax
        data-speed="0.22"
        data-axis="y"
        data-dir="up"
      />
    </div>
    <div
      class="absolute inset-0 opacity-[0.22]"
      style="background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 22px 22px;"
      data-parallax
      data-speed="0.08"
      data-axis="y"
      data-dir="down"
    />
    <div class="absolute inset-0 opacity-[0.05]" style="background: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27n%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23n)%27/%3E%3C/svg%3E')" />
  </div>

  <Container>
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="mx-auto max-w-xl text-center lg:mx-0 lg:text-left">
        <div class="inline-flex items-center gap-2 rounded-full bg-[--surface] px-4 py-2 hairline">
          <span class="relative size-2 rounded-full bg-emerald-400">
            <span class="absolute inset-0 rounded-full bg-emerald-400 opacity-40 blur-[6px]" />
          </span>
          <span class="text-xs font-semibold tracking-wide text-[--muted]">Available for UI UX Design | Product Design</span>
        </div>

        <h1 class="mt-7 font-display text-5xl leading-[1.02] tracking-tight sm:text-6xl">
          Rahul <span class="grad-text">— UI/UX Designer</span>
        </h1>
        <p class="mt-6 text-base text-muted sm:text-lg">
          I design premium product experiences that feel effortless, communicate value fast, and convert—through
          sharp UX hierarchy, clean UI, and polished interactions.
        </p>

        <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
          <a href="#work" class="btn btn-primary w-full sm:w-auto">
            View Work <span aria-hidden="true">→</span>
          </a>
          <a href="#contact" class="btn btn-secondary w-full sm:w-auto">
            Hire Me
          </a>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-3 sm:gap-4">
          {[
            { k: "5+", v: "Years designing" },
            { k: "20+", v: "Shipped projects" },
            { k: "End-to-end", v: "Research → UI" },
          ].map((s) => (
          <div class="glass card px-4 py-4 text-left">
              <div class="font-display text-2xl tracking-tight">{s.k}</div>
              <div class="mt-1 text-xs text-muted">{s.v}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Floating UI mockup visual (subtle, does not overpower text) -->
      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div
          class="pointer-events-none absolute -inset-6 -z-10 card opacity-80 blur-2xl"
          style="background: radial-gradient(circle at 30% 30%, rgba(167,139,250,.22), transparent 60%), radial-gradient(circle at 70% 55%, rgba(96,165,250,.16), transparent 55%);"
          data-parallax
          data-speed="0.18"
          data-axis="y"
          data-dir="up"
        />

        <div class="relative overflow-hidden card border border-[--border] bg-[rgba(255,255,255,0.02)] shadow-[--shadow-lg]">
          <div class="absolute inset-0 opacity-25" data-mouse-layer data-depth="0.35"
            style="background: linear-gradient(135deg, rgba(167,139,250,.25), rgba(240,171,252,.10), rgba(96,165,250,.18));"
          />
          <div class="absolute inset-0 opacity-[0.10]" data-mouse-layer data-depth="0.6"
            style="background-image: radial-gradient(rgba(255,255,255,0.12) 1px, transparent 1px); background-size: 18px 18px;"
          />

          <div class="relative p-3 sm:p-4" data-mouse-layer data-depth="1">
            <!-- SaaS Dashboard Mockup -->
            <div class="relative h-[340px] w-full overflow-hidden rounded-xl bg-[#0a0a12] sm:h-[420px]" style="box-shadow: 0 25px 50px -12px rgba(139, 92, 246, 0.25), 0 0 100px rgba(139, 92, 246, 0.15) inset;">
              <!-- Header -->
              <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
                <div class="flex items-center gap-2">
                  <div class="flex gap-1.5">
                    <div class="h-3 w-3 rounded-full bg-red-500/80"></div>
                    <div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
                    <div class="h-3 w-3 rounded-full bg-green-500/80"></div>
                  </div>
                  <span class="ml-3 text-xs font-medium text-white/60">Analytics Dashboard</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></div>
                  <div class="h-6 w-6 rounded-full bg-gradient-to-br from-violet-500 to-purple-600"></div>
                </div>
              </div>

              <div class="flex h-[calc(100%-48px)]">
                <!-- Sidebar -->
                <div class="w-14 border-r border-white/10 bg-[#0d0d18] py-4 sm:w-16">
                  <div class="flex flex-col items-center gap-4">
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-500/20 text-violet-400">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 8a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 12a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 16a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
                    </div>
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg text-white/40 hover:bg-white/5 hover:text-white/70">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/></svg>
                    </div>
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg text-white/40 hover:bg-white/5 hover:text-white/70">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9zM4 5a2 2 0 012-2 2 2 0 012 2v2a2 2 0 01-2 2 2 2 0 01-2-2V5zm0 6a2 2 0 012-2h2a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6zm10-2a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V9zM14 13a2 2 0 012-2h2a2 2 0 012 2v6a2 2 0 01-2 2h-2a2 2 0 01-2-2v-6z"/></svg>
                    </div>
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg text-white/40 hover:bg-white/5 hover:text-white/70">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"/></svg>
                    </div>
                  </div>
                </div>

                <!-- Main Content -->
                <div class="flex-1 overflow-hidden p-3 sm:p-4">
                  <!-- Stats Row -->
                  <div class="mb-3 grid grid-cols-3 gap-2 sm:gap-3">
                    <div class="rounded-lg bg-white/5 p-2 sm:p-3">
                      <div class="text-[10px] text-white/50">Revenue</div>
                      <div class="text-sm font-bold text-white sm:text-base">$18.4K</div>
                      <div class="flex items-center gap-1 text-[10px] text-emerald-400">
                        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12 7a1 1 0 01-1 1H9v7a1 1 0 01-2 0V8H5a1 1 0 01-1-1V5a1 1 0 011-1h7a1 1 0 011 1v2z" clip-rule="evenodd"/></svg>
                        +12.8%
                      </div>
                    </div>
                    <div class="rounded-lg bg-white/5 p-2 sm:p-3">
                      <div class="text-[10px] text-white/50">Users</div>
                      <div class="text-sm font-bold text-white sm:text-base">1,245</div>
                      <div class="flex items-center gap-1 text-[10px] text-emerald-400">
                        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12 7a1 1 0 01-1 1H9v7a1 1 0 01-2 0V8H5a1 1 0 01-1-1V5a1 1 0 011-1h7a1 1 0 011 1v2z" clip-rule="evenodd"/></svg>
                        +5.3%
                      </div>
                    </div>
                    <div class="rounded-lg bg-white/5 p-2 sm:p-3">
                      <div class="text-[10px] text-white/50">Projects</div>
                      <div class="text-sm font-bold text-white sm:text-base">68</div>
                      <div class="text-[10px] text-yellow-400">In Progress</div>
                    </div>
                  </div>

                  <!-- Chart Area -->
                  <div class="mb-3 rounded-lg bg-white/5 p-3">
                    <div class="mb-2 flex items-center justify-between">
                      <span class="text-[10px] font-medium text-white/70">Revenue Overview</span>
                      <div class="flex gap-2">
                        <span class="h-2 w-2 rounded-full bg-violet-500"></span>
                        <span class="h-2 w-2 rounded-full bg-purple-400"></span>
                      </div>
                    </div>
                    <!-- SVG Chart -->
                    <svg class="h-16 w-full sm:h-20" viewBox="0 0 200 60" preserveAspectRatio="none">
                      <defs>
                        <linearGradient id="chartGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                          <stop offset="0%" style="stop-color:rgba(139,92,246,0.4)"/>
                          <stop offset="100%" style="stop-color:rgba(139,92,246,0)"/>
                        </linearGradient>
                      </defs>
                      <path d="M0 45 Q20 35, 40 40 T80 30 T120 35 T160 25 T200 20 L200 60 L0 60 Z" fill="url(#chartGrad)"/>
                      <path d="M0 45 Q20 35, 40 40 T80 30 T120 35 T160 25 T200 20" fill="none" stroke="#8b5cf6" stroke-width="2"/>
                      <path d="M0 50 Q30 42, 60 45 T120 38 T180 32 T200 28" fill="none" stroke="#a78bfa" stroke-width="1.5" stroke-dasharray="4,2"/>
                    </svg>
                  </div>

                  <!-- Bottom Row -->
                  <div class="grid grid-cols-2 gap-2 sm:gap-3">
                    <!-- Task Completion -->
                    <div class="rounded-lg bg-white/5 p-3">
                      <div class="text-[10px] text-white/50 mb-2">Task Completion</div>
                      <div class="relative mx-auto h-14 w-14 sm:h-16 sm:w-16">
                        <svg class="h-full w-full -rotate-90" viewBox="0 0 36 36">
                          <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="3"/>
                          <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="url(#progressGrad)" stroke-width="3" stroke-dasharray="76, 100"/>
                          <defs>
                            <linearGradient id="progressGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                              <stop offset="0%" style="stop-color:#8b5cf6"/>
                              <stop offset="100%" style="stop-color:#06b6d4"/>
                            </linearGradient>
                          </defs>
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center">
                          <span class="text-xs font-bold text-white">76%</span>
                        </div>
                      </div>
                    </div>

                    <!-- Notification Card -->
                    <div class="rounded-lg bg-gradient-to-br from-violet-500/20 to-purple-600/20 p-3 border border-violet-500/30">
                      <div class="flex items-start gap-2">
                        <div class="h-6 w-6 rounded-lg bg-violet-500/30 flex items-center justify-center flex-shrink-0">
                          <svg class="h-3 w-3 text-violet-300" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
                        </div>
                        <div>
                          <div class="text-[10px] font-medium text-white/80">New Message</div>
                          <div class="text-[8px] text-white/50 mt-0.5">John: "Review the latest report"</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Purple Ambient Glow Behind -->
            <div class="pointer-events-none absolute -inset-4 -z-10 rounded-3xl bg-violet-500/20 blur-3xl"></div>
          </div>

          <!-- Mount the mouse parallax controller inside the visual block -->
          <MouseParallax client:load strength={14} />
        </div>
      </div>
    </div>
  </Container>
</section>

