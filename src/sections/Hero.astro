---
import Container from "../components/ui/Container.astro";
import AboutCharacterVideo from "../components/motion/AboutCharacterVideo";
---

<section id="hero" class="relative min-h-[90dvh] flex flex-col justify-center overflow-hidden pt-32 pb-24 bg-[--color-background]" data-hero-root>

  <Container class="relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      {/* LEFT COLUMN: Editorial Copy */}
      <div class="lg:col-span-6 space-y-10" data-hero-item>

        {/* Highlight Pill */}
        <div class="inline-flex items-center gap-3 bg-[--color-surface] border border-[--color-border] px-5 py-2 rounded-full shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[--color-accent]"></span>
          <span class="text-[10px] font-mono font-bold tracking-[0.25em] uppercase text-[--color-text]">
            1+ YEAR EXPERIENCE
          </span>
        </div>

        {/* Expressive Editorial Headline */}
        <h1 class="font-display text-5xl sm:text-7xl lg:text-8xl font-medium tracking-tighter text-[--color-text] leading-[0.95]">
          I make complex <br />
          things feel <br />
          <span class="italic font-serif text-[--color-accent]">beautifully simple.</span>
        </h1>

        {/* Narrative Description */}
        <p class="text-base sm:text-xl font-normal leading-relaxed text-[--color-text-secondary] max-w-lg">
          I'm a UI/UX Designer focused on SaaS, AI and digital products, transforming user needs and complex workflows into intuitive experiences.
        </p>

        {/* Call to Actions */}
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a
            href="#work"
            class="group inline-flex items-center gap-3 bg-[--color-text] text-[--color-background] px-10 py-4 rounded-full text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:bg-[--color-accent] hover:shadow-lg hover:-translate-y-0.5"
          >
            <span>Explore My Work</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 bg-transparent border border-[--color-border] px-8 py-4 rounded-full text-[--color-text] text-xs font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:border-[--color-text] hover:bg-[--color-surface] hover:-translate-y-0.5"
          >
            <span>Download Résumé</span>
          </a>
        </div>
      </div>

      {/* Right Column: Character Visual */}
      <div class="lg:col-span-6 relative flex items-center justify-center min-h-[400px] lg:min-h-[500px]" data-hero-visual>
        <div class="relative w-full z-10 scale-100 hover:scale-[1.02] transition-transform duration-700">
          <AboutCharacterVideo client:load />
        </div>
      </div>

    </div>
  </Container>
</section>

<style>
    /* Ensure seamless transition to next section */
    #hero {
        background-color: var(--color-background);
    }
</style>
