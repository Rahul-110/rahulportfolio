---
import Container from "../components/ui/Container.astro";
import HeroReveal from "../components/motion/HeroReveal";
---

<section class="relative min-h-[90dvh] flex flex-col justify-center overflow-hidden pb-20 pt-24" data-hero-root>
  <Container>
    <div class="max-w-4xl">
      <div class="inline-block mb-10" data-hero-item>
        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-[--muted2]">
          Senior Product & UI/UX Designer
        </span>
      </div>

      <h1 class="font-display text-[14vw] font-bold leading-[0.88] tracking-tighter sm:text-[100px] lg:text-[120px]" data-hero-item>
        Product<br />
        & UI/UX<br />
        <span class="text-[--muted2]">Designer</span>
      </h1>

      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-end">
        <div data-hero-item>
          <p class="max-w-md text-lg leading-relaxed text-[--muted]">
            I'm a design system nerd with a product brain and good UX. With a love for clean
            structure and messy hypotheses, I turn complex tasks into simple, user-friendly solutions.
          </p>
          <div class="mt-10">
            <a href="#work" class="btn btn-primary rounded-full px-10 py-5 text-[11px] font-bold">
              VIEW PROJECTS <span class="ml-2">↘</span>
            </a>
          </div>
        </div>

        <div class="flex justify-end gap-8 pb-4" data-hero-item>
          <a href="#" class="text-[10px] font-bold uppercase tracking-widest text-[--muted2] hover:text-white transition">Behance</a>
          <a href="#" class="text-[10px] font-bold uppercase tracking-widest text-[--muted2] hover:text-white transition">Dribbble</a>
          <a href="#" class="text-[10px] font-bold uppercase tracking-widest text-[--muted2] hover:text-white transition">LinkedIn</a>
        </div>
      </div>
    </div>
  </Container>

  <!-- High-end ambient light: one source, no "blobs" -->
  <div class="pointer-events-none absolute -bottom-40 -left-20 h-[600px] w-[600px] rounded-full bg-white/[0.02] blur-[120px]"></div>

  <HeroReveal client:load />
</section>
