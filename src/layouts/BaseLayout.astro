---
import "../styles/global.css";
import MotionRoot from "../components/motion/MotionRoot";
import InteractiveBackground from "../components/ui/InteractiveBackground";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Rahul Portfolio",
  description = "UI/UX designer portfolio with case studies, process, and high-end interactions.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('portfolio-theme')) {
          return localStorage.getItem('portfolio-theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body class="bg-[--color-background] text-[--color-text] antialiased relative">
    <InteractiveBackground client:load />
    <MotionRoot client:load />
    <slot />
  </body>
</html>
